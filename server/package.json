{
  "name": "@diary/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b ../shared && tsx watch --env-file=../.env src/main.ts | pino-pretty",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run --config ../vitest.config.ts --project unit --project integration",
    "test:unit": "vitest run --config ../vitest.config.ts --project unit",
    "test:integration": "vitest run --config ../vitest.config.ts --project integration",
    "test:watch": "vitest --config ../vitest.config.ts --project unit",
    "test:coverage": "vitest run --config ../vitest.config.ts --coverage --project unit --project integration",
    "cli": "tsc -b ../shared && tsx --env-file=../.env src/cli.ts",
    "seed": "tsc -b ../shared && tsx --env-file=../.env src/cli.ts seed",
    "test:functional": "vitest run --config ../vitest.config.ts --project functional"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^10.1.1",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
