# Copy to .env for local use and fill in. NEVER commit .env — it is gitignored.
# On Vercel: paste the same values into Project → Settings → Environment Variables.

# Domain Caddy serves and gets an HTTPS certificate for (compose.yaml deploy).
# Its DNS A record must point at the server. Use localhost to try it locally.
DOMAIN=localhost

# PostgreSQL. On Vercel use the Neon POOLED host (host contains "-pooler");
# Neon requires SSL (enforced automatically in serverless mode).
# Postgres only applies these when the database volume is first created;
# changing PGPASSWORD later needs the rotation steps in the README.
# With compose.yaml, PGHOST/PGPORT are overridden to point at the db container.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=riji
PGUSER=riji
PGPASSWORD=change-me

# Super admin master key (32 bytes hex = 64 chars). Generate: openssl rand -hex 32
# Encrypts stored data — changing it later makes existing data unreadable.
SUPER_ADMIN_MASTER_KEY=

# JWT secret for session tokens. Generate: openssl rand -hex 32
JWT_SECRET=

# Secret required by Vercel Cron when it calls POST /api/count/auto-run
# (Authorization: Bearer <CRON_SECRET>). Generate: openssl rand -hex 16
CRON_SECRET=

# Android APK auto-update: version reported by /api/app-version on Vercel
# (no persistent filesystem there). Format: build timestamp yyyyMMddHHmmss,
# must match the APK filename/versionName. Bump per release.
APP_VERSION=

# SMTP (optional - codes logged to console if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=riji@localhost

# Translation (OpenAI-compatible API). Without a key the Translate button returns an error.
# Base URL and model default to agnes-ai if left empty.
TRANSLATE_API_KEY=
TRANSLATE_API_BASE_URL=
TRANSLATE_MODEL=
